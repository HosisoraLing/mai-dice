{
  "manifest_version": 2,
  "id": "com.hosisora.mai-dice",
  "version": "1.0.0",
  "name": "MaiDice",
  "description": "MaiBot TRPG 骰娘插件，支持掷骰、技能检定、人物卡管理、先攻系统和日志记录",
  "author": {
    "name": "HosisoraLing",
    "url": "https://github.com/HosisoraLing"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/HosisoraLing/mai-dice"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "2.99.99"
  },
  "sdk": {
    "min_version": "2.4.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": ["send_message", "send.text", "send.image", "send.custom", "chat.get_stream_by_user_id", "chat.get_private_streams"],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
